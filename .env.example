# S-VAN Configuration
# Copy to .env and fill in values

# Stacks Network
STACKS_NETWORK=testnet

# Agent Session Configuration
AGENT_DAILY_LIMIT_USD=50
AGENT_PER_TX_LIMIT_USD=10
AGENT_SESSION_EXPIRY_HOURS=24

# x402 Paid API Server
X402_SERVER_PORT=3402
X402_SERVER_HOST=http://localhost:3402

# Stacks Recipient Address (for x402 payments)
X402_RECIPIENT_ADDRESS=ST1CKNN84MDPCJRQDHDCY34GMRKQ3TASNNDJQDRTN

# Veridex Relayer (optional, for gasless transactions)
VERIDEX_RELAYER_URL=https://relayer.veridex.network
VERIDEX_RELAYER_API_KEY=

# Hiro API Key (for Stacks RPC)
HIRO_API_KEY=
